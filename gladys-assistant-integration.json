{
  "manifest_version": 1,
  "type": "device",
  "name": "Hydro-Québec",
  "description": {
    "en": "Hydro-Québec electricity consumption, Winter Credit and Flex D peaks, billing and outages.",
    "fr": "Consommation Hydro-Québec, pointes Crédit Hivernal et Flex D, facturation et pannes."
  },
  "version": "0.1.6",
  "docker_image": "ghcr.io/lm1lc3n7/gladys-hydro-quebec:0.1.6",
  "gladys_version": ">=5.1.0",
  "cover_image": "https://raw.githubusercontent.com/LM1LC3N7/Gladys-Hydro-Quebec/main/cover.png",
  "categories": ["energy"],
  "transports": ["cloud"],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "Hydro-Québec account",
        "fr": "Compte Hydro-Québec"
      },
      "description": {
        "en": "Use the same email/username and password you use to sign in to the Hydro-Québec customer space (session.hydroquebec.com). This integration is developed independently and is not supported by Hydro-Québec: do not contact Hydro-Québec customer service about it. Every contract on the account is discovered automatically after saving — there is nothing else to enter (no account/contract numbers needed).",
        "fr": "Utilisez le même courriel/identifiant et mot de passe que pour vous connecter à l'Espace client Hydro-Québec (session.hydroquebec.com). Cette intégration est développée de façon indépendante et n'est pas supportée par Hydro-Québec : ne contactez pas le service à la clientèle d'Hydro-Québec à son sujet. Tous les contrats du compte sont découverts automatiquement après l'enregistrement — rien d'autre à saisir (aucun numéro de compte/contrat requis)."
      },
      "links": [
        {
          "url": "https://session.hydroquebec.com/",
          "label": {
            "en": "Hydro-Québec customer space",
            "fr": "Espace client Hydro-Québec"
          }
        },
        {
          "url": "https://gitlab.com/hydroqc/hydroqc",
          "label": {
            "en": "hydroqc (the library this integration relies on)",
            "fr": "hydroqc (la librairie utilisée par cette intégration)"
          }
        }
      ]
    },
    {
      "key": "username",
      "type": "secret",
      "label": {
        "en": "Email / username",
        "fr": "Courriel / identifiant"
      },
      "description": {
        "en": "The email address or username used to sign in to your Hydro-Québec online account.",
        "fr": "Le courriel ou l'identifiant utilisé pour vous connecter à votre compte Hydro-Québec en ligne."
      },
      "required": true
    },
    {
      "key": "password",
      "type": "secret",
      "label": {
        "en": "Password",
        "fr": "Mot de passe"
      },
      "description": {
        "en": "Stored encrypted by Gladys and never leaves your instance except to talk to Hydro-Québec.",
        "fr": "Stocké chiffré par Gladys, il ne quitte jamais votre instance sauf pour parler à Hydro-Québec."
      },
      "required": true
    },
    {
      "key": "poll_frequency",
      "type": "number",
      "label": {
        "en": "Refresh interval (s)",
        "fr": "Intervalle de rafraîchissement (s)"
      },
      "description": {
        "en": "How often each contract is refreshed. Hydro-Québec updates daily consumption about once a day with a 1-2 day delay, so there is no benefit in polling faster than every 30-60 minutes.",
        "fr": "Fréquence de rafraîchissement de chaque contrat. Hydro-Québec ne met à jour la consommation quotidienne qu'une fois par jour, avec 1 à 2 jours de délai : inutile d'interroger plus vite que toutes les 30-60 minutes."
      },
      "required": false,
      "default": 3600,
      "min": 300,
      "max": 86400
    },
    {
      "key": "preheat_duration_minutes",
      "type": "number",
      "label": {
        "en": "Pre-heat duration (min)",
        "fr": "Durée de préchauffage (min)"
      },
      "description": {
        "en": "How long before a Winter Credit / Flex D critical peak the \"pre-heat in progress\" sensor turns on. Only affects contracts enrolled in one of these options.",
        "fr": "Combien de temps avant une pointe critique (Crédit Hivernal / Flex D) le capteur « préchauffage en cours » s'active. N'a d'effet que sur les contrats inscrits à l'une de ces options."
      },
      "required": false,
      "default": 180,
      "min": 0,
      "max": 360
    }
  ],
  "actions": [
    {
      "key": "test_connection",
      "label": {
        "en": "Test the connection",
        "fr": "Tester la connexion"
      },
      "timeout_seconds": 30
    }
  ],
  "scene_triggers": [
    {
      "key": "critical_peak_announced",
      "label": {
        "en": "Hydro-Québec critical peak announced",
        "fr": "Pointe critique Hydro-Québec annoncée"
      },
      "description": {
        "en": "Hydro-Québec announced a Winter Credit or Flex D critical peak (usually the day before).",
        "fr": "Hydro-Québec a annoncé une pointe critique Crédit hivernal ou Flex D (généralement la veille)."
      },
      "fields": [
        {
          "key": "contract",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "Contract",
            "fr": "Contrat"
          },
          "description": {
            "en": "Leave empty for any contract.",
            "fr": "Laissez vide pour tous les contrats."
          },
          "required": false
        },
        {
          "key": "period",
          "type": "select",
          "label": {
            "en": "Peak period",
            "fr": "Période de pointe"
          },
          "description": {
            "en": "Leave empty for both.",
            "fr": "Laissez vide pour les deux."
          },
          "options": [
            {
              "value": "morning",
              "label": {
                "en": "Morning (6:00-10:00)",
                "fr": "Matin (6 h - 10 h)"
              }
            },
            {
              "value": "evening",
              "label": {
                "en": "Evening (16:00-20:00)",
                "fr": "Soir (16 h - 20 h)"
              }
            }
          ],
          "required": false
        }
      ],
      "variables": [
        {
          "key": "day",
          "type": "string",
          "label": {
            "en": "Peak day (YYYY-MM-DD)",
            "fr": "Jour de la pointe (AAAA-MM-JJ)"
          }
        },
        {
          "key": "start_time",
          "type": "string",
          "label": {
            "en": "Peak start time",
            "fr": "Heure de début de la pointe"
          }
        },
        {
          "key": "end_time",
          "type": "string",
          "label": {
            "en": "Peak end time",
            "fr": "Heure de fin de la pointe"
          }
        },
        {
          "key": "period",
          "type": "string",
          "label": {
            "en": "Period (morning/evening)",
            "fr": "Période (morning/evening)"
          }
        },
        {
          "key": "rate",
          "type": "string",
          "label": {
            "en": "Rate option (winter_credit/flex_d)",
            "fr": "Option tarifaire (winter_credit/flex_d)"
          }
        },
        {
          "key": "contract_id",
          "type": "string",
          "label": {
            "en": "Contract number",
            "fr": "Numéro de contrat"
          }
        },
        {
          "key": "starts_at",
          "type": "string",
          "label": {
            "en": "Peak start (ISO 8601)",
            "fr": "Début de la pointe (ISO 8601)"
          }
        },
        {
          "key": "ends_at",
          "type": "string",
          "label": {
            "en": "Peak end (ISO 8601)",
            "fr": "Fin de la pointe (ISO 8601)"
          }
        }
      ]
    },
