{
  "manifest_version": 1,
  "type": "device",
  "name": "Tibber",
  "description": {
    "en": "Unofficial connector: Tibber prices, cheap hours, consumption, Pulse live power and contracts.",
    "fr": "Connecteur non officiel : prix Tibber, heures creuses, consommation, puissance Pulse et contrats."
  },
  "version": "0.1.0",
  "docker_image": "ghcr.io/lm1lc3n7/gladys-tibber:0.1.0",
  "gladys_version": ">=5.2.0",
  "cover_image": "https://raw.githubusercontent.com/LM1LC3N7/gladys-tibber/main/cover.png",
  "categories": ["energy"],
  "transports": ["cloud"],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "Tibber account",
        "fr": "Compte Tibber"
      },
      "description": {
        "en": "Unofficial connector, not affiliated with Tibber. Create a personal access token on developer.tibber.com (Settings → Access token) and paste it below: the integration discovers your homes, reads the hourly prices (today and tomorrow), your consumption, and, with a Tibber Pulse or Watty, the live power. It also offers a Tibber contract template for the Gladys energy monitoring. Tibber is a trademark of Tibber AS.",
        "fr": "Connecteur non officiel, sans lien avec Tibber. Créez un jeton d'accès personnel sur developer.tibber.com (Settings → Access token) et collez-le ci-dessous : l'intégration découvre vos maisons, lit les prix horaires (aujourd'hui et demain), votre consommation et, avec un Tibber Pulse ou Watty, la puissance en direct. Elle fournit aussi un modèle de contrat Tibber pour le suivi énergétique de Gladys. Tibber est une marque de Tibber AS."
      },
      "links": [
        {
          "url": "https://developer.tibber.com/settings/access-token",
          "label": {
            "en": "Create an access token",
            "fr": "Créer un jeton d'accès"
          }
        },
        {
          "url": "https://github.com/LM1LC3N7/gladys-tibber/blob/main/docs/fr.md",
          "label": {
            "en": "Guide (French)",
            "fr": "Guide (français)"
          }
        },
        {
          "url": "https://github.com/LM1LC3N7/gladys-tibber/blob/main/docs/en.md",
          "label": {
            "en": "Guide (English)",
            "fr": "Guide (anglais)"
          }
        }
      ]
    },
    {
      "key": "access_token",
      "type": "secret",
      "required": true,
      "label": {
        "en": "Access token",
        "fr": "Jeton d'accès"
      },
      "description": {
        "en": "Stored encrypted by Gladys and only sent to api.tibber.com.",
        "fr": "Stocké chiffré par Gladys et envoyé uniquement à api.tibber.com."
      }
    },
    {
      "key": "cheap_hours",
      "type": "number",
      "required": false,
      "default": 4,
      "min": 1,
      "max": 12,
      "label": {
        "en": "Cheap hours per day",
        "fr": "Heures creuses par jour"
      },
      "description": {
        "en": "The N cheapest hours of the day make the \"cheap period\" (sensor, triggers, widget).",
        "fr": "Les N heures les moins chères de la journée forment la « période creuse » (capteur, déclencheurs, widget)."
      }
    },
    {
      "key": "live",
      "type": "boolean",
      "required": false,
      "default": true,
      "label": {
        "en": "Live power from a Tibber Pulse / Watty",
        "fr": "Puissance en direct d'un Tibber Pulse / Watty"
      },
      "description": {
        "en": "Keeps a websocket open to Tibber for the homes with real-time consumption enabled.",
        "fr": "Garde une connexion websocket ouverte vers Tibber pour les maisons dont la consommation en temps réel est activée."
      }
    }
  ],
  "actions": [
    {
      "key": "test_connection",
      "timeout_seconds": 30,
      "label": {
        "en": "Test the connection",
        "fr": "Tester la connexion"
      },
      "description": {
        "en": "Reads the account and the current price of each home.",
        "fr": "Lit le compte et le prix actuel de chaque maison."
      }
    }
  ],
  "widgets": [
    {
      "key": "prices",
      "label": {
        "en": "Tibber prices",
        "fr": "Prix Tibber"
      },
      "description": {
        "en": "Now, next, today's and tomorrow's average, the level, the cheapest hours and the price curve.",
        "fr": "Maintenant, ensuite, moyennes du jour et de demain, niveau, heures creuses et courbe des prix."
      },
      "icon": "trending-down",
      "settings": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "required": true,
          "label": {
            "en": "Home",
            "fr": "Maison"
          }
        }
      ]
    },
    {
      "key": "live",
      "label": {
        "en": "Tibber live power",
        "fr": "Puissance Tibber en direct"
      },
      "description": {
        "en": "Power gauge, today's kWh and cost, peak, voltages and currents from the Pulse.",
        "fr": "Jauge de puissance, kWh et coût du jour, pic, tensions et courants du Pulse."
      },
      "icon": "zap",
      "settings": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "required": true,
          "label": {
            "en": "Home",
            "fr": "Maison"
          }
        }
      ]
    }
  ],
  "scene_triggers": [
    {
      "key": "cheap_period_started",
      "label": {
        "en": "Tibber cheap period started",
        "fr": "Début des heures creuses Tibber"
      },
      "description": {
        "en": "The current slot is one of the cheapest hours of the day (see \"Cheap hours per day\").",
        "fr": "Le créneau actuel fait partie des heures les moins chères de la journée (voir « Heures creuses par jour »)."
      },
      "fields": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "required": true,
          "label": {
            "en": "Home",
            "fr": "Maison"
          }
        }
      ],
      "variables": [
        {
          "key": "price",
          "type": "number",
          "label": {
            "en": "Price per kWh",
            "fr": "Prix par kWh"
          }
        },
        {
          "key": "currency",
          "type": "string",
          "label": {
            "en": "Currency",
            "fr": "Devise"
          }
        },
        {
          "key": "level",
          "type": "string",
          "label": {
            "en": "Price level",
            "fr": "Niveau de prix"
          }
        },
        {
          "key": "ends_at",
          "type": "string",
          "label": {
            "en": "End of the slot",
            "fr": "Fin du créneau"
          }
        }
      ]
    },
    {
      "key": "cheap_period_ended",
      "label": {
        "en": "Tibber cheap period ended",
        "fr": "Fin des heures creuses Tibber"
      },
      "description": {
        "en": "The current slot is no longer one of the cheapest hours of the day.",
        "fr": "Le créneau actuel ne fait plus partie des heures les moins chères de la journée."
      },
      "fields": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "required": true,
          "label": {
            "en": "Home",
