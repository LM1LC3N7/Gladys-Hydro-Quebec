          "type": "string",
          "label": {
            "en": "Cheapest window end (local time)",
            "fr": "Fin de la fenêtre la moins chère (heure locale)"
          }
        }
      ]
    },
    {
      "key": "cheapest_window",
      "label": {
        "en": "Tibber cheapest hours",
        "fr": "Heures Tibber les moins chères"
      },
      "description": {
        "en": "The start and end of the cheapest N consecutive hours of a period, to wait for them or announce them.",
        "fr": "Le début et la fin des N heures consécutives les moins chères d'une période, pour les attendre ou les annoncer."
      },
      "timeout_seconds": 10,
      "fields": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "required": true,
          "label": {
            "en": "Home",
            "fr": "Maison"
          }
        },
        {
          "key": "hours",
          "type": "number",
          "required": false,
          "min": 1,
          "max": 12,
          "label": {
            "en": "Hours (empty: the configured cheap hours)",
