              "label": {
                "en": "Tomorrow",
                "fr": "Demain"
              }
            }
          ]
        }
      ],
      "outputs": [
        {
          "key": "found",
          "type": "boolean",
          "label": {
            "en": "A window was found",
            "fr": "Une fenêtre a été trouvée"
