      "label": {
        "en": "Tibber tomorrow's prices published",
        "fr": "Prix Tibber de demain publiés"
      },
      "description": {
        "en": "Tomorrow's prices just appeared (around 13:00), with the average, the extremes and the cheapest window.",
        "fr": "Les prix de demain viennent d'apparaître (vers 13 h), avec la moyenne, les extrêmes et la fenêtre la moins chère."
      },
      "fields": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "required": true,
          "label": {
            "en": "Home",
