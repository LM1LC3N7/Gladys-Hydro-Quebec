            "fr": "Début (ISO)"
          }
        },
        {
          "key": "end",
          "type": "string",
          "label": {
            "en": "End (ISO)",
            "fr": "Fin (ISO)"
          }
        },
        {
          "key": "start_time",
          "type": "string",
          "label": {
            "en": "Start (local time)",
