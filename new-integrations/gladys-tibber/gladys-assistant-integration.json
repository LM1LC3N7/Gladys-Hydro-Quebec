          "label": {
            "en": "Minutes until the start",
            "fr": "Minutes avant le début"
          }
        },
        {
          "key": "avg_price",
          "type": "number",
          "label": {
            "en": "Average price of the window",
            "fr": "Prix moyen de la fenêtre"
          }
        },
        {
          "key": "saving_percent",
          "type": "number",
          "label": {
            "en": "Saving against the period average (%)",
            "fr": "Économie par rapport à la moyenne de la période (%)"
          }
        },
        {
          "key": "currency",
          "type": "string",
          "label": {
            "en": "Currency",
            "fr": "Devise"
          }
        }
      ]
    }
  ],
  "energy_contracts": {
    "templates": [
      {
        "key": "tibber-no",
        "name": {
          "en": "Tibber (Norway)",
          "fr": "Tibber (Norvège)"
        },
        "description": {
          "en": "Your Tibber hourly price (energy, VAT included) read from your account, plus the monthly subscription. The integration prices every half hour from the Tibber price history.",
          "fr": "Votre prix horaire Tibber (énergie, TVA incluse) lu depuis votre compte, plus l'abonnement mensuel. L'intégration tarife chaque demi-heure depuis l'historique des prix Tibber."
        },
        "country": "NO",
        "currency": "NOK",
        "timezone": "Europe/Oslo",
        "pricing_mode": "delegated",
        "version": "2026-10-13",
        "inputs": [
          {
            "key": "home_id",
            "type": "string",
            "required": false,
            "label": {
              "en": "Tibber home id (empty: the first home)",
              "fr": "Identifiant de la maison Tibber (vide : la première)"
            },
            "description": {
              "en": "Shown in the device params and by the test button; only needed with several homes.",
              "fr": "Visible dans les paramètres de l'appareil et par le bouton de test ; utile seulement avec plusieurs maisons."
            }
          },
          {
            "key": "subscription",
            "type": "number",
            "unit": "NOK/month",
