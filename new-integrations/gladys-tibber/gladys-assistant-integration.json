          "key": "power",
          "type": "number",
          "label": {
            "en": "Power (W)",
            "fr": "Puissance (W)"
          }
        }
      ]
    }
  ],
  "scene_actions": [
    {
      "key": "get_price",
      "label": {
        "en": "Tibber price now",
        "fr": "Prix Tibber actuel"
      },
      "description": {
        "en": "The current price, its level, whether it is in the cheap hours, the next price, today's figures and the cheapest window, for a condition or a message.",
        "fr": "Le prix actuel, son niveau, s'il est dans les heures creuses, le prix suivant, les chiffres du jour et la fenêtre la moins chère, pour une condition ou un message."
      },
      "timeout_seconds": 10,
      "fields": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "required": true,
          "label": {
            "en": "Home",
            "fr": "Maison"
          }
        }
      ],
      "outputs": [
        {
          "key": "available",
          "type": "boolean",
          "label": {
            "en": "Prices known",
            "fr": "Prix connus"
          }
        },
        {
          "key": "price",
          "type": "number",
          "label": {
            "en": "Price per kWh",
            "fr": "Prix par kWh"
          }
        },
        {
          "key": "currency",
          "type": "string",
          "label": {
            "en": "Currency",
            "fr": "Devise"
          }
        },
