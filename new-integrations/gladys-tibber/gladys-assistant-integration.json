                "fr": "Bon marché"
              }
            },
            {
              "value": "NORMAL",
              "label": {
                "en": "Normal",
                "fr": "Normal"
              }
            },
            {
              "value": "EXPENSIVE",
              "label": {
                "en": "Expensive",
                "fr": "Cher"
              }
            },
            {
              "value": "VERY_EXPENSIVE",
              "label": {
                "en": "Very expensive",
                "fr": "Très cher"
              }
            }
