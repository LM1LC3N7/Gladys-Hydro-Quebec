        },
        {
          "key": "level",
          "type": "multi_select",
          "required": false,
          "label": {
            "en": "New level (empty: any)",
            "fr": "Nouveau niveau (vide : tous)"
          },
          "options": [
            {
              "value": "VERY_CHEAP",
              "label": {
                "en": "Very cheap",
