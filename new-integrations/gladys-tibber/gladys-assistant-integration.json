    {
      "key": "power_threshold_crossed",
      "label": {
        "en": "Tibber live power crossed a mark",
        "fr": "Puissance Tibber : seuil franchi"
      },
      "description": {
        "en": "The live power of the Pulse went above or below the chosen number of watts.",
        "fr": "La puissance en direct du Pulse est passée au-dessus ou en dessous du nombre de watts choisi."
      },
      "fields": [
        {
          "key": "device",
          "type": "select",
          "source": "devices",
          "required": true,
          "label": {
            "en": "Home",
            "fr": "Maison"
          }
        },
